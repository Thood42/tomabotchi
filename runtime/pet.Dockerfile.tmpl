# Generated by tomabotchi (docker_ops.ensure_pet_image): a home image plus the pet runtime.
FROM {runtime} AS runtime
FROM {home}
COPY --from=runtime /opt/hermes /opt/hermes
COPY --from=runtime /opt/tomabotchi /opt/tomabotchi
# The home's own tools come first (its python3, node, ...); the runtime's commands are appended.
ENV PATH=$PATH:/opt/tomabotchi/bin:/opt/hermes/bin \
    HERMES_PYTHON=/opt/hermes/.venv/bin/python \
    HERMES_RUNTIME_DIR=/opt/hermes/tools \
    HOME=/home/pet \
    HERMES_HOME=/home/pet/.hermes \
    HERMES_WRITE_SAFE_ROOT=/workspace:/home/pet:/tmp \
    PYTHONUNBUFFERED=1
RUN /opt/tomabotchi/bin/smoke
USER 1000:1000
WORKDIR /workspace
LABEL tomabotchi.runtime="{runtime}" tomabotchi.home="{home}"
ENTRYPOINT ["/opt/tomabotchi/bin/petd"]
