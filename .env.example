# Copy to .env (git-ignored) and fill in. bin/tomabotchi passes it to the server.

# For pets on Claude models. The server keeps it; pets never see it.
ANTHROPIC_API_KEY=

# The dashboard's port on 127.0.0.1 (default 8770).
# TOMABOTCHI_PORT=8770

# Where the server finds Ollama (default: the host's :11434).
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# With `docker compose --profile ollama up -d` (an Ollama of its own, for machines without one), use:
# OLLAMA_BASE_URL=http://host.docker.internal:11435
# It publishes on the Docker bridge address (172.17.0.1); set OLLAMA_BIND to change it.
